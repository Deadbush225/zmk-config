#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// 1. Set the baseline speed for your normal Layer 1 mouse (Counts per second)
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    

// 2. Include the pointing header
#include <dt-bindings/zmk/pointing.h> 

// 3. Define custom "Fast" velocities for your modifier layer
#define M_UP_FST    MOVE_Y(-3500)
#define M_DWN_FST   MOVE_Y(3500)
#define M_LFT_FST   MOVE_X(-3500)
#define M_RGT_FST   MOVE_X(3500)

// 4. Override default mouse acceleration OUTSIDE the root node
&mmv {
    time-to-max-speed-ms = <0>; 
    acceleration-exponent = <0>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // LAYER 0: Base Layout
        default_layer {
            bindings = <
            // Col 1     Col 2     Col 3     Col 4     Col 5     Col 6     Col 7     Col 8     Col 9     Col 10    Col 11    Col 12    Col 13    Col 14    Col 15    Col 16
            &gresc    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC  &kp INS   &none     // Row 1
            &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH  &kp DEL   &none     // Row 2
            &kp CAPS  &none     &kp A     &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp RET   &kp PG_UP &none     // Row 3
            &kp LSHFT &none     &kp Z     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &none     &kp RSHFT &kp PG_DN &kp UP    // Row 4
            &kp LCTRL &mo 1     &kp LGUI  &kp LALT  &mo 2     &none     &kp SPACE &none     &none     &none     &kp RALT  &kp K_APP &kp RCTRL &kp LEFT  &kp RIGHT &kp DOWN  // Row 5
            >;
        };

        // LAYER 1: Normal Mouse (Activated by holding 'mo 1')
        fn_layer {
            bindings = <
            // Col 1         Col 2        Col 3        Col 4        Col 5     Col 6     Col 7     Col 8            Col 9           Col 10           Col 11            Col 12             Col 13    Col 14    Col 15    Col 16
            &trans        &kp F1       &kp F2       &kp F3       &kp F4    &kp F5    &kp F6    &kp F7           &kp F8          &kp F9           &kp F10           &kp F11            &kp F12   &trans    &trans    &trans    // Row 1
            &bt BT_CLR_ALL &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans    &trans    &trans    &mkp LCLK        &mmv MOVE_UP    &mkp RCLK        &msc SCRL_UP      &trans             &trans    &trans    &trans    &trans    // Row 2
            &trans        &trans       &trans       &trans       &trans    &trans    &trans    &msc SCRL_LEFT   &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_RIGHT   &msc SCRL_RIGHT    &trans    &trans    &trans    &trans    // Row 3
            &trans        &trans       &trans       &trans       &trans    &trans    &trans    &mkp MCLK        &msc SCRL_DOWN  &trans           &trans            &trans             &trans    &trans    &trans    &trans    // Row 4
            &trans        &trans       &trans       &trans       &trans    &trans    &trans    &trans           &trans          &trans           &trans            &trans             &trans    &trans    &trans    &trans    // Row 5
            >;
        };

        // LAYER 2: Fast Mouse (Activated by holding 'mo 2')
        fast_mouse_layer {
            bindings = <
            // Col 1   Col 2   Col 3   Col 4   Col 5   Col 6   Col 7   Col 8   Col 9          Col 10         Col 11         Col 12  Col 13  Col 14  Col 15  Col 16
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans         &trans         &trans  &trans  &trans  &trans  &trans  // Row 1
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mmv M_UP_FST  &trans         &trans         &trans  &trans  &trans  &trans  &trans  // Row 2
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mmv M_LFT_FST &mmv M_DWN_FST &mmv M_RGT_FST &trans  &trans  &trans  &trans  &trans  // Row 3
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans         &trans         &trans  &trans  &trans  &trans  &trans  // Row 4
            &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans         &trans         &trans  &trans  &trans  &trans  &trans  // Row 5
            >;
        };
    };
};