#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

// 1. --- SPEEDS ---
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1100  
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    

#include <dt-bindings/zmk/pointing.h> 

// 2. --- ACCELERATION ---
&mmv {
    time-to-max-speed-ms = <400>; 
    acceleration-exponent = <1>;  
};

/ {
    behaviors {
        mlt: mouse_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "MOUSE_LAYER_TAP";
            #binding-cells = <2>;
            flavor = "hold-preferred"; 
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
            // Col 1     Col 2     Col 3      Col 4     Col 5     Col 6     Col 7     Col 8     Col 9     Col 10    Col 11    Col 12    Col 13    Col 14    Col 15    Col 16
            &gresc    &kp N1    &kp N2     &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL &kp BSPC  &kp INS   &none     
            &kp TAB   &kp Q     &mlt 1 W   &kp E     &kp R     &kp T     &kp Y     &kp U     &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT  &kp BSLH  &kp DEL   &none     
            &kp CAPS  &none     &kp A      &kp S     &kp D     &kp F     &kp G     &kp H     &kp J     &kp K     &kp L     &kp SEMI  &kp SQT   &kp RET   &kp PG_UP &none     
            &kp LSHFT &none     &kp Z      &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &kp COMMA &kp DOT   &kp FSLH  &none     &kp RSHFT &kp PG_DN &kp UP    
            &kp LCTRL &mo 2     &kp LGUI   &kp LALT  &none     &none     &kp SPACE &none     &none     &none     &kp RALT  &kp K_APP &kp RCTRL &kp LEFT  &kp RIGHT &kp DOWN  
            >;
        };

        mouse_layer {
            bindings = <
            // Col 1   Col 2   Col 3    Col 4        Col 5        Col 6       Col 7   Col 8           Col 9           Col 10           Col 11            Col 12            Col 13   Col 14   Col 15   Col 16
            &none   &none   &none    &none        &none        &none       &none   &none           &none           &none            &none             &none             &none    &none    &none    &none   
            &none   &none   &trans   &mkp LCLK    &mkp RCLK    &none       &none   &msc SCRL_UP    &mmv MOVE_UP    &msc SCRL_DOWN   &none             &none             &none    &none    &none    &none   
            &none   &none   &none    &none        &mkp MCLK    &none       &none   &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_RIGHT   &msc SCRL_RIGHT   &none    &none    &none    &none   
            &none   &none   &none    &none        &none        &none       &none   &none           &none           &none            &none             &none             &none    &none    &none    &none   
            &none   &none   &none    &none        &none        &none       &none   &none           &none           &none            &none             &none             &none    &none    &none    &none   
            >;
        };

        fn_layer {
            bindings = <
            &trans        &kp F1       &kp F2       &kp F3       &kp F4    &kp F5    &kp F6    &kp F7    &kp F8    &kp F9    &kp F10   &kp F11   &kp F12   &trans    &trans    &trans    
            &bt BT_CLR_ALL &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    
            &trans        &trans       &trans       &trans       &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    
            &trans        &trans       &trans       &trans       &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    
            &trans        &trans       &trans       &trans       &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    &trans    
            >;
        };
    };
};