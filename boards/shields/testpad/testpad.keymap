#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        // LAYER 0: Base Layout
        default_layer {
            bindings = <
            // Col 1     Col 2     Col 3     Col 4     Col 5     Col 6     Col 7       Col 8     Col 9     Col 10    Col 11    Col 12    Col 13    Col 14    Col 15    Col 16
            &gresc    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6      &kp N7    &kp N8    &kp N9    &kp EQUAL &kp MINUS &kp N0    &kp BSPC  &kp INS   &none     // Row 1
            &kp TAB   &kp Q     &kp W     &kp E     &kp R     &kp T     &kp Y       &kp U     &kp I     &kp O     &kp RBKT  &kp LBKT  &kp P     &kp BSLH  &kp DEL   &none     // Row 2
            &kp CAPS  &none     &kp A     &kp S     &kp D     &kp F     &kp G       &kp H     &kp J     &kp K     &kp SQT   &kp SEMI  &kp L     &kp RET   &kp PG_UP &none     // Row 3
            &kp LSHFT &none     &kp Z     &kp X     &kp C     &kp V     &kp B       &kp N     &kp M     &kp COMMA &none     &kp FSLH  &kp DOT   &kp RSHFT &kp PG_DN &kp UP    // Row 4
            &kp LCTRL &mo 1     &kp LGUI  &kp LALT  &none     &none     &kp SPACE   &none     &none     &none     &kp RCTRL &kp K_APP &kp RALT  &kp LEFT  &kp RIGHT &kp DOWN  // Row 5 (Left and Right Swapped)
            >;
        };

        // LAYER 1: Activated by holding 'Fn'
        fn_layer {
            bindings = <
            // Col 1      Col 2       Col 3       Col 4       Col 5       Col 6       Col 7       Col 8       Col 9       Col 10      Col 11    Col 12    Col 13    Col 14    Col 15    Col 16
            &trans      &kp F1      &kp F2      &kp F3      &kp F4      &kp F5      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10   &trans    &trans    &trans    &trans    &trans    // Row 1: Restored F1-F10
            &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &trans      &trans      &trans      &trans      &trans      &trans      &trans    &trans    &trans    &trans    &trans    &trans    // Row 2: Bluetooth Controls
            &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans    &trans    &trans    &trans    &trans    &trans    // Row 3
            &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans    &trans    &trans    &trans    &trans    &trans    // Row 4
            &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans      &trans    &trans    &trans    &trans    &trans    &trans    // Row 5
            >;
        };
    };
};