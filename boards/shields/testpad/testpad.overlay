#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        
        /* The switch is wired between Pin 0.06 and Ground.
           We use PULL_UP so the pin reads HIGH normally, 
           and goes LOW when the switch is pressed. */
        input-gpios = <&gpio0 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};