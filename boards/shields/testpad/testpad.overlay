#include <dt-bindings/zmk/keys.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col"; 

        // 5 ROWS (Pushing power - no anchors needed)
        row-gpios
            = <&gpio0 9  GPIO_ACTIVE_HIGH> // Row 1
            , <&gpio0 10 GPIO_ACTIVE_HIGH> // Row 2
            , <&gpio1 11 GPIO_ACTIVE_HIGH> // Row 3
            , <&gpio1 13 GPIO_ACTIVE_HIGH> // Row 4
            , <&gpio1 15 GPIO_ACTIVE_HIGH> // Row 5
            ;

        // 16 COLUMNS (Listening - PULL_DOWN anchors added to block static)
        col-gpios
            // Left Side (Top to Bottom)
            = <&gpio0 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 1
            , <&gpio0 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 2
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 3
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 4
            , <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 5
            , <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 6
            , <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 7
            , <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 8
            , <&gpio1 4  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 9
            , <&gpio1 6  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 10
            // Top Edge (Left to Right)
            , <&gpio0 1  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 11
            , <&gpio0 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 12
            , <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 13
            // Right Side Bottom (Ascending to meet the rows)
            , <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 14
            , <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 15
            , <&gpio0 2  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> // Col 16
            ;
    };
};